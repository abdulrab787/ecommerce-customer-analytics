	measure Waterfall_Steps = ```
			
			DATATABLE(
			    "Step", STRING,
			    {
			        {"Total Revenue"},
			        {"CLV Uplift"},
			        {"Churn Loss"},
			        {"Net Profit"}
			    }
			)
			
