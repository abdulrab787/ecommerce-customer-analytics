		formatString: 0
		displayFolder: _RFM
		lineageTag: 77c4ee86-9c38-4108-8138-836ab71f5dbc

	measure F_Score = ```
			
			VAR RankF =
			    RANKX(
			        ALLSELECTED(campaign_data),
			        [F_Frequency],
			        ,
			        DESC
			    )
			VAR TotalSeg =
			    CALCULATE(
			        DISTINCTCOUNT(campaign_data[customer_segment]),
			        ALLSELECTED(campaign_data)
			    )
			VAR Quantile = DIVIDE(RankF, TotalSeg)
			RETURN
			SWITCH(
			    TRUE(),
			    Quantile <= 1/3, 5,
			    Quantile <= 2/3, 3,
			    1
			)
			
			```
		formatString: 0
		displayFolder: _RFM
		lineageTag: 7cf5d6e2-6a52-4c7f-9ed6-56d95ed17b57

