	/// Spend per conversion
	measure CPA = DIVIDE ( [Total Spend], [Total Conversions] )
		formatString: #,0.00
		displayFolder: _Cost & ROI
		lineageTag: 5c3ade8a-7f5e-4797-82ac-3bae4bc3acdb

