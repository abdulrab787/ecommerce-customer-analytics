		lineageTag: 22487f50-d8af-4bdf-b12c-dba8e1a041c7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure R_Score = ```
			
			VAR RankR =
			    RANKX(
			        ALLSELECTED(campaign_data),
			        [R_Recency],
			        ,
			        ASC
			    )
			VAR TotalSeg =
			    CALCULATE(
			        DISTINCTCOUNT(campaign_data[customer_segment]),
			        ALLSELECTED(campaign_data)
			    )
			VAR Quantile = DIVIDE(RankR, TotalSeg)
			RETURN
			SWITCH(
			    TRUE(),
			    Quantile <= 1/3, 5,
			    Quantile <= 2/3, 3,
			    1
			)
			
			```
		formatString: 0
		displayFolder: _RFM
		lineageTag: 0e152e68-0012-4d73-8e3f-a0cbb5d05f62

	measure RFM_Score = ```
			
			[R_Score] + [F_Score] + [M_Score]
			
			```
		formatString: 0
		displayFolder: _RFM
		lineageTag: 680201cc-1185-4d20-8529-00c038e0da98

	measure F_Frequency = ```
			
