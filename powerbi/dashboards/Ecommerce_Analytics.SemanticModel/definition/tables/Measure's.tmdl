	/// Waterfall deltas; the visual's automatic Total bar = contribution.
	measure 'Waterfall Value' =
			SWITCH ( SELECTEDVALUE ( Waterfall_Steps[Step] ),
			    "Total Revenue", [Total Revenue],
			    "Media Spend", - [Total Spend]
			)
		formatString: #,0
