	/// Simple average of per-campaign CTR. Prefer [CTR] (ratio of sums) for totals.
	measure 'Avg CTR' = AVERAGEX ( campaign_data, DIVIDE ( campaign_data[clicks], campaign_data[impressions] ) )
		formatString: 0.00%
		displayFolder: _KPI
		lineageTag: 93efee18-d0e4-4890-b763-4813cf7b69c2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg CVR' = AVERAGEX ( campaign_data, DIVIDE ( campaign_data[conversions], campaign_data[clicks] ) )
